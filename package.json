{
  "name": "developer-notch",
  "version": "0.2.0",
  "private": true,
  "description": "Floating attention capsule for developers on Windows.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint . --ignore-pattern \"spikes/**\" --ignore-pattern \"src-tauri/**\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rust": "npm run build:bridge && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "tauri build --debug --no-bundle --features e2e && wdio run tests/e2e-tauri/wdio.conf.mts",
    "build:bridge": "vite build --config vite.bridge.config.mts",
    "dev:tauri-renderer": "npm run build:bridge && vite --config vite.tauri.config.mts",
    "build:tauri-renderer": "npm run build:bridge && vite build --config vite.tauri.config.mts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:e2e:tauri": "npm run test:e2e",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource/jersey-10": "5.3.0",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "@wdio/types": "10.1.0",
    "eslint": "10.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "webdriverio": "10.1.0"
  }
}
