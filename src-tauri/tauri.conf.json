{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Developer Notch",
  "version": "../package.json",
  "identifier": "dev.developernotch.app",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../out/tauri-renderer",
    "beforeDevCommand": "npm run dev:tauri-renderer",
    "beforeBuildCommand": "npm run build:tauri-renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Developer Notch",
    "copyright": "© 2026 Developer Notch",
    "shortDescription": "Floating attention capsule for developers on Windows.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": true,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
